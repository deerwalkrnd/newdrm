APP_NAME=DRM
APP_ENV=production
APP_KEY=
APP_DEBUG=true
APP_URL=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

IP = 
GP_EMAIL = 


BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- Database backups to GitHub (see scripts/backup/README.md) -------------
# Nothing here is required. dmt sets the switch, the GitHub token, the
# trigger secret and the healthcheck URL on the Database Backups page
# (stored encrypted with APP_KEY; those values win over these).
DUMP_ENABLED=false
DUMP_GITHUB_TOKEN=
DUMP_GITHUB_OWNER=deerwalk-dumps
DUMP_GITHUB_REPO=DMR-dumps
DUMP_TRIGGER_SECRET=
DUMP_HEALTHCHECK_URL=
# HR usernames allowed on the Backups page (everyone else gets a 404).
DUMP_ADMIN_USERNAMES=dmt
# Optional read-only DB user for dumps. Empty = use DB_USERNAME/DB_PASSWORD.
DUMP_DB_USERNAME=
DUMP_DB_PASSWORD=
# auto = mysqldump if it can run, else the built-in PHP dumper. Or: mysqldump | php
DUMP_METHOD=auto
